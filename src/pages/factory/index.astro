---
import '../../styles/global.css';
// Single source of truth, injected by the factory-state Vite plugin.
import factoryState from 'virtual:factory-state';
import Navigation from '../../components/design/Navigation.astro';
import Footer from '../../components/design/Footer.astro';

const state = factoryState;

const counts = state.counts || {};
const sites = (state.sites || []).filter((s) => s.id !== 'templates');
const experiments = state.experiments || [];
const lessons = state.lessons || [];
const tasks = state.tasks || [];
const runningTasks = state.runningTasks || [];
const memories = state.memory?.files || [];
const missions = (state.missions || []).slice().sort((a, b) => String(b.updated_at || b.created_at || '').localeCompare(String(a.updated_at || a.created_at || '')));
const runningMissions = missions.filter((m) => m.status === 'running' || m.status === 'review');
const queuedMissions = missions.filter((m) => m.status === 'queued');
const completedMissions = missions.filter((m) => m.status === 'completed');
const updated = state.lastSync || state.updated || '';
const runningAgents = state.runningAgents ?? 0;

const formatDate = (iso) => {
  if (!iso) return '—';
  try {
    return new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
  } catch {
    return iso;
  }
};

const formatTime = (t) => (t ? String(t).slice(0, 2) + ':' + String(t).slice(2) : '—');

const statusLabel = (s) => ({ deployed: 'deployed', local: 'local', queued: 'queued', running: 'running', review: 'review', complete: 'complete', completed: 'completed', live: 'live', research: 'research', shipped: 'shipped' }[s] || s);

const heroCounts = [
  { label: 'Active Missions', value: runningMissions.length, href: '/factory/#missions' },
  { label: 'Completed', value: completedMissions.length, href: '/factory/#completed' },
  { label: 'Running Agents', value: Number(runningAgents) || 0, href: '/factory/#missions' },
  { label: 'Lessons', value: counts.lessons ?? 0, href: '/factory/#lessons' }
];

const stepProgress = (steps) => {
  const s = steps || [];
  const done = s.filter((x) => x.time).length;
  return s.length ? Math.round((done / s.length) * 100) : 0;
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>AI Factory OS — Mission Center</title>
    <meta name="description" content="AI Factory OS: mission queue, running missions, completed missions, timeline, agent status, lessons and preview links." />
  </head>
  <body data-theme="dark">
    <div class="command-page">
      <Navigation theme="dark" current="/factory/" />

      <main>
        <section class="cc-hero" aria-labelledby="cc-title">
          <div class="cc-hero-copy">
            <p class="eyebrow"><span class="live-dot"></span> Factory OS / Mission Runtime</p>
            <h1 id="cc-title">Mission<br />Center</h1>
            <p class="cc-lede">A transparent operating view of the website factory: mission queue, running work, completed missions, timelines, and the memory loop.</p>
            <div class="cc-meta">
              <span>STATE: <strong>.factory/state.json</strong></span>
              <span>LAST SYNC: <strong>{formatDate(updated)}</strong></span>
            </div>
          </div>
          <div class="cc-hero-panel" aria-label="Factory counts">
            <div class="panel-head"><span>AI FACTORY OS</span><span>P8 / MISSION RUNTIME</span></div>
            <div class="count-grid">
              {heroCounts.map((c) => (
                <a class="count-card" href={c.href}>
                  <strong>{String(c.value).padStart(2, '0')}</strong>
                  <span>{c.label}</span>
                </a>
              ))}
            </div>
            <div class="panel-foot"><span>MISSION QUEUE</span><span class="live">{missions.length} TOTAL</span></div>
          </div>
        </section>

        <section class="cc-section" id="missions" aria-labelledby="missions-title">
          <div class="cc-section-head"><p class="section-label">01 / Mission Queue</p><h2 id="missions-title">Running</h2></div>
          {
            runningMissions.length === 0 ? (
              <div class="empty-state">
                <p>No missions currently running. Queue one with <code>pnpm factory:mission:create --title "Replicate Stripe Landing"</code>.</p>
                <button class="empty-cta" type="button" onclick="navigator.clipboard.writeText('pnpm factory:mission:create --title Replicate-Stripe-Landing').then(() => { this.textContent = 'Copied'; })">Create Mission</button>
              </div>
            ) : (
              <div class="mission-grid">
                {runningMissions.map((m) => (
                  <article class="mission-card running">
                    <div class="mission-top"><span class="site-status {m.status}">{statusLabel(m.status)}</span><span class="mission-agent">{m.agent || 'codex'}</span></div>
                    <h3>{m.title}</h3>
                    <div class="mission-progress"><span style={`width: ${stepProgress(m.steps)}%`}></span></div>
                    <div class="mission-progress-label"><span>{stepProgress(m.steps)}%</span><span>{(m.steps || []).filter((s) => s.time).length} / {(m.steps || []).length} steps</span></div>
                    <div class="mission-timeline">
                      {(m.steps || []).map((s, i) => (
                        <div class={`tl-step ${s.time ? 'done' : ''}`}>
                          <span class="tl-time">{s.time || '—'}</span>
                          <span class="tl-label">{s.label}</span>
                        </div>
                      ))}
                    </div>
                    {m.previewUrl && <a class="link-out" href={m.previewUrl} target="_blank" rel="noopener noreferrer">Preview ↗</a>}
                  </article>
                ))}
              </div>
            )
          }
          {
            queuedMissions.length > 0 && (
              <div class="queued-list">
                <p class="queued-label">QUEUED</p>
                {queuedMissions.map((m) => (
                  <div class="queued-row"><span class="site-status queued">{statusLabel(m.status)}</span><strong>{m.title}</strong><span class="mission-agent">{m.agent || 'codex'}</span></div>
                ))}
              </div>
            )
          }
        </section>

        <section class="cc-section" id="completed" aria-labelledby="completed-title">
          <div class="cc-section-head"><p class="section-label">02 / Completed</p><h2 id="completed-title">Recently Done</h2></div>
          <div class="completed-list">
            {
              completedMissions.length === 0 ? (
                <p class="empty-state">No completed missions yet.</p>
              ) : (
                completedMissions.slice(0, 8).map((m) => (
                  <div class="completed-row">
                    <span class="site-status completed">{statusLabel(m.status)}</span>
                    <strong>{m.title}</strong>
                    <span class="mission-agent">{m.agent || 'codex'}</span>
                    <span class="completed-date">{formatDate(m.completed_at || m.updated_at)}</span>
                    {m.previewUrl && <a class="link-out" href={m.previewUrl} target="_blank" rel="noopener noreferrer">Preview ↗</a>}
                  </div>
                ))
              )
            }
          </div>
        </section>

        <section class="cc-section" id="sites" aria-labelledby="sites-title">
          <div class="cc-section-head"><p class="section-label">03 / Generated sites</p><h2 id="sites-title">Preview Links</h2></div>
          <div class="site-grid ds-list-stagger">
            {sites.map((s) => (
              <div class="site-card">
                <div class="site-top"><span class="site-status {s.status}">{statusLabel(s.status)}</span><span class="site-cat">{s.category || 'generated site'}</span></div>
                <h3>{s.name}</h3>
                <p class="site-ref">Reference: {s.reference || '—'}</p>
                <div class="site-links">
                  {s.previewUrl ? <a class="link-out" href={s.previewUrl} target="_blank" rel="noopener noreferrer">Preview ↗</a> : <span class="link-out muted">no preview</span>}
                  <a class="link-out" href={s.page}>Local page ↗</a>
                </div>
                <span class="site-created">{formatDate(s.created)}</span>
              </div>
            ))}
          </div>
        </section>

        <section class="cc-section" id="lessons" aria-labelledby="lessons-title">
          <div class="cc-section-head"><p class="section-label">04 / Lessons</p><h2 id="lessons-title">Memory Loop</h2></div>
          <div class="memory-grid">
            <div class="memory-panel">
              <div class="memory-top"><span>MEMORY / {memories.length} FILES</span><span class="mem-ok">{state.memory?.status || '—'}</span></div>
              <ul class="memory-files">
                {memories.map((m) => <li><code>{m}</code></li>)}
              </ul>
            </div>
            <div class="memory-panel dark">
              <div class="memory-top"><span>LESSONS / {lessons.length}</span><span class="mem-warn">what worked / what failed</span></div>
              {
                lessons.length === 0 ? (
                  <p class="empty-state">No lessons recorded yet. Complete a mission to write the first lesson.</p>
                ) : (
                  <ul class="lesson-list">
                    {lessons.slice(0, 8).map((l) => (
                      <li class="lesson {l.outcome}">
                        <span class="lesson-outcome">{l.outcome}</span>
                        <strong>{l.title}</strong>
                        <span class="lesson-pattern">{(l.pattern || '').replace(/-+$/, '')}</span>
                        {l.worked && <span class="lesson-content"><b>Worked</b>: {l.worked}</span>}
                        {l.failed && l.failed !== 'None observed.' && <span class="lesson-content fail"><b>Failed</b>: {l.failed}</span>}
                        <span class="lesson-source">{l.source}</span>
                      </li>
                    ))}
                  </ul>
                )
              }
            </div>
          </div>
        </section>

        <section class="cc-section flow-section" aria-labelledby="flow-title">
          <div class="cc-section-head"><p class="section-label">05 / Mission CLI</p><h2 id="flow-title">Runtime Commands</h2></div>
          <div class="task-flow">
            {['Create', 'Start', 'Review', 'Complete'].map((step, i) => (
              <div class="flow-step">
                <span>{String(i + 1).padStart(2, '0')}</span>
                <strong>{step}</strong>
                {i < 3 && <i aria-hidden="true">→</i>}
              </div>
            ))}
          </div>
          <div class="cli-grid">
            <code>pnpm factory:mission:create --title "Replicate Stripe Landing"</code>
            <code>pnpm factory:mission:start mission-001</code>
            <code>pnpm factory:mission:review mission-001</code>
            <code>pnpm factory:mission:complete mission-001</code>
          </div>
        </section>
      </main>

      <Footer theme="dark" label="Factory OS / Mission Runtime" />

      <script is:inline>
        (function () {
          var nums = document.querySelectorAll('.count-card strong');
          var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!nums.length || reduced) return;
          var dur = 800;
          function run() {
            nums.forEach(function (el) {
              var target = parseInt(el.textContent.replace(/\D/g, ''), 10) || 0;
              var start = null;
              function step(ts) {
                if (!start) start = ts;
                var t = Math.min((ts - start) / dur, 1);
                var eased = 1 - Math.pow(1 - t, 3);
                el.textContent = String(Math.round(eased * target)).padStart(2, '0');
                if (t < 1) requestAnimationFrame(step);
              }
              requestAnimationFrame(step);
            });
          }
          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
          else run();
        })();
      </script>
    </div>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; background: #0d1512; }
  :global(body) { margin: 0; color: #dce9df; background: #0d1512; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  :global(a) { color: inherit; }
  .command-page { min-height: 100vh; }
  .site-header, main, .site-footer { width: min(1180px, calc(100% - 64px)); margin: 0 auto; }
  .site-header { display: flex; align-items: center; justify-content: space-between; height: 78px; border-bottom: 1px solid #274031; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: #f0f5ed; font-size: 14px; font-weight: 800; text-decoration: none; }
  .brand-mark { display: grid; place-items: center; width: 31px; height: 31px; color: #102018; background: #b9d957; font: 800 10px ui-monospace, monospace; }
  .header-tag { color: #87ac99; font: 10px ui-monospace, monospace; letter-spacing: .1em; }
  nav { display: flex; gap: 28px; }
  nav a { color: #7f998a; font: 11px ui-monospace, monospace; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
  nav a:hover, nav a[aria-current] { color: #b9d957; }
  .cc-hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(300px, .75fr); align-items: center; gap: 84px; padding: 82px 0 96px; }
  .eyebrow, .section-label { color: #8ec3a8; font: 700 10px/1.3 ui-monospace, monospace; letter-spacing: .14em; text-transform: uppercase; }
  .eyebrow { display: flex; align-items: center; gap: 9px; margin-bottom: 25px; }
  .live-dot { width: 7px; height: 7px; background: #b9d957; border-radius: 50%; box-shadow: 0 0 0 5px rgba(185, 217, 87, .16); }
  h1 { margin: 0; color: #f0f5ed; font-size: clamp(58px, 7.8vw, 96px); line-height: .94; letter-spacing: -.05em; font-weight: 800; }
  .cc-lede { max-width: 560px; margin: 26px 0 0; color: #8fa99b; font-size: 18px; line-height: 1.5; }
  .cc-meta { display: flex; flex-wrap: wrap; gap: 26px; margin-top: 34px; color: #5f7d6c; font: 10px ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
  .cc-meta strong { color: #b9d957; font-weight: 700; }
  .cc-hero-panel { padding: 20px; border: 1px solid #274031; background: #111d18; box-shadow: 14px 14px 0 #111a16; }
  .panel-head, .panel-foot, .memory-top, .site-top { display: flex; justify-content: space-between; color: #5f7d6c; font: 10px ui-monospace, monospace; letter-spacing: .1em; text-transform: uppercase; }
  .panel-head span:last-child, .panel-foot span:last-child { color: #b9d957; }
  .count-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin: 24px 0; }
  .count-card { display: grid; gap: 8px; padding: 18px 16px; border: 1px solid #243c30; background: #132019; text-decoration: none; }
  .count-card strong { color: #f0f5ed; font-size: 44px; line-height: .9; letter-spacing: -.04em; font-variant-numeric: tabular-nums; }
  .count-card span { color: #8fa99b; font: 10px ui-monospace, monospace; text-transform: uppercase; letter-spacing: .08em; }
  .count-card:hover { border-color: #b9d957; }
  .cc-section { padding: 112px 0; border-top: 1px solid #213527; }
  .cc-section-head { display: flex; align-items: end; justify-content: space-between; gap: 24px; }
  .cc-section-head h2 { margin: 16px 0 0; color: #f0f5ed; font-size: clamp(34px, 4.5vw, 48px); line-height: 1.04; font-weight: 500; letter-spacing: -.05em; }
  .empty-state { display: grid; gap: 16px; justify-items: start; margin: 30px 0 0; color: #6e8678; font-size: 14px; }
  .empty-state p { margin: 0; }
  .empty-cta { display: inline-flex; align-items: center; min-height: 46px; padding: 0 22px; border: 0; background: var(--color-acid); color: #102018; font: 700 13px/1 var(--font-sans); cursor: pointer; transition: background var(--duration-fast) var(--ease-out); }
  .empty-cta:hover { background: var(--color-acid-strong); }
  .empty-state code, .memory-files code { color: #b9d957; font: 11px ui-monospace, monospace; }
  .task-list { margin-top: 52px; border-top: 1px solid #2b4234; }
  .task-row { display: grid; grid-template-columns: 110px 1fr 1.4fr 110px; align-items: center; gap: 16px; min-height: 66px; border-bottom: 1px solid #2b4234; }
  .task-status { display: inline-flex; align-items: center; gap: 8px; color: #6f8879; font: 10px ui-monospace, monospace; text-transform: uppercase; }
  .task-status i { width: 7px; height: 7px; background: #b9d957; border-radius: 50%; }
  .task-row strong { color: #e7efe8; font-size: 15px; }
  .task-ref { color: #7f9889; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .task-style { color: #52705e; font: 10px ui-monospace, monospace; text-transform: uppercase; }
  .task-list.muted { opacity: .6; }
  .site-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 52px; }
  .site-card { display: grid; gap: 15px; padding: 22px; border: 1px solid #2b4234; background: #111d18; }
  .site-card h3 { margin: 0; color: #f0f5ed; font-size: 21px; letter-spacing: -.035em; }
  .site-ref { margin: 0; color: #6e8678; font-size: 13px; }
  .site-links { display: flex; gap: 18px; }
  .link-out { color: #b9d957; font: 700 11px ui-monospace, monospace; text-decoration: none; text-transform: uppercase; letter-spacing: .06em; }
  .link-out.muted { color: #52645a; }
  .site-status { display: inline-flex; align-items: center; gap: 7px; color: #8fa99b; font: 10px ui-monospace, monospace; text-transform: uppercase; }
  .site-status.deployed, .site-status.live, .site-status.shipped, .site-status.complete { color: #8fd39a; }
  .site-status.local, .site-status.research { color: #d4a744; }
  .site-created { color: #52645a; font: 10px ui-monospace, monospace; }
  .exp-list { margin-top: 52px; border-top: 1px solid #2b4234; }
  .exp-row { display: grid; grid-template-columns: 70px 1fr 130px 24px; align-items: center; gap: 16px; min-height: 62px; border-bottom: 1px solid #2b4234; color: #8fa99b; text-decoration: none; }
  .exp-row:hover strong { color: #b9d957; }
  .exp-id { color: #5f7d6c; font: 10px ui-monospace, monospace; }
  .exp-row strong { color: #e7efe8; font-size: 15px; }
  .exp-status { color: #6e8678; font: 10px ui-monospace, monospace; text-transform: uppercase; text-align: right; }
  .exp-arrow { color: #b9d957; text-align: right; }
  .memory-grid { display: grid; grid-template-columns: 1fr 1.5fr; gap: 14px; margin-top: 52px; }
  .memory-panel { padding: 22px; border: 1px solid #2b4234; background: #111d18; }
  .memory-panel.dark { background: #0d1712; }
  .mem-ok { color: #8fd39a; }
  .mem-warn { color: #d4a744; }
  .memory-files, .lesson-list { margin: 24px 0 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  .memory-files li { padding: 10px 0; border-bottom: 1px solid #22362a; }
  .lesson { display: grid; grid-template-columns: 62px 1fr; gap: 7px 14px; padding: 12px 0; border-bottom: 1px solid #22362a; }
  .lesson-outcome { align-self: start; color: #8fd39a; font: 9px ui-monospace, monospace; text-transform: uppercase; padding-top: 2px; }
  .lesson.fail .lesson-outcome { color: #d98a6f; }
  .lesson strong { color: #e7efe8; font-size: 14px; line-height: 1.3; }
  .lesson-pattern { grid-column: 2; color: #6e8678; font-size: 12px; line-height: 1.45; }
  .lesson-source { grid-column: 2; color: #52645a; font: 9px ui-monospace, monospace; }
  .task-flow { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 52px; border-top: 1px solid #2b4234; border-bottom: 1px solid #2b4234; }
  .flow-step { position: relative; display: grid; gap: 26px; min-height: 112px; padding: 16px 10px 16px 0; border-right: 1px solid #2b4234; }
  .flow-step:not(:first-child) { padding-left: 10px; }
  .flow-step:last-child { border-right: 0; }
  .flow-step span { color: #b9d957; font: 10px ui-monospace, monospace; }
  .flow-step strong { align-self: end; color: #f0f5ed; font-size: 13px; }
  .flow-step i { position: absolute; top: 50%; right: -7px; z-index: 1; color: #b9d957; background: #0d1512; font-style: normal; }
  .site-footer { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding: 23px 0 30px; border-top: 1px solid #213527; color: #5f7d6c; font: 10px ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
  .site-footer > div { display: flex; align-items: center; gap: 8px; color: #8fa99b; font-weight: 800; }
  .site-footer a { color: #b9d957; text-decoration: none; }

  /* ---- Mission OS (P8) ---- */
  .site-status.running, .site-status.review { color: #d4eb73; }
  .site-status.completed, .site-status.complete { color: #8fd39a; }
  .site-status.queued { color: #d4a744; }
  .mission-agent { color: #6e8678; font: 10px ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
  .mission-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 52px; }
  .mission-card { display: grid; gap: 14px; padding: 22px; border: 1px solid #2b4234; background: #111d18; }
  .mission-card.running { border-color: #3c5f4e; }
  .mission-top { display: flex; justify-content: space-between; gap: 12px; }
  .mission-card h3 { margin: 0; color: #f0f5ed; font-size: 21px; letter-spacing: -.035em; }
  .mission-progress { height: 4px; background: #22362a; overflow: hidden; }
  .mission-progress span { display: block; height: 100%; background: #b9d957; transition: width .4s var(--ease-out, cubic-bezier(0.22,1,0.36,1)); }
  .mission-progress-label { display: flex; justify-content: space-between; color: #6e8678; font: 10px ui-monospace, monospace; text-transform: uppercase; letter-spacing: .06em; }
  .mission-timeline { display: grid; gap: 0; border-left: 1px solid #2b4234; padding-left: 14px; }
  .tl-step { position: relative; display: grid; grid-template-columns: 46px 1fr; gap: 8px; padding: 6px 0; color: #52645a; }
  .tl-step::before { content: ""; position: absolute; left: -19px; top: 11px; width: 9px; height: 9px; border-radius: 50%; background: #22362a; }
  .tl-step.done { color: #8fa99b; }
  .tl-step.done::before { background: #b9d957; box-shadow: 0 0 0 3px rgba(185, 217, 87, .15); }
  .tl-time { font: 10px ui-monospace, monospace; }
  .tl-label { font-size: 12px; }
  .queued-list { margin-top: 18px; border-top: 1px solid #2b4234; }
  .queued-label { margin: 16px 0 0; color: #52645a; font: 10px ui-monospace, monospace; letter-spacing: .1em; text-transform: uppercase; }
  .queued-row { display: grid; grid-template-columns: 90px 1fr 90px; align-items: center; gap: 14px; min-height: 52px; border-bottom: 1px solid #2b4234; }
  .queued-row strong { color: #c6d4c9; font-size: 14px; }
  .completed-list { margin-top: 52px; border-top: 1px solid #2b4234; }
  .completed-row { display: grid; grid-template-columns: 110px 1fr 110px 130px auto; align-items: center; gap: 14px; min-height: 64px; border-bottom: 1px solid #2b4234; }
