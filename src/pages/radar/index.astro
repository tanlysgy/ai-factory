---
import '../../styles/global.css';
import Navigation from '../../components/design/Navigation.astro';
import Footer from '../../components/design/Footer.astro';

const experiments = [
	{ number: '001', title: 'Cost Reduction Fake Door', status: 'Research record', href: '/experiments/cost-reduction/' },
	{ number: '002', title: 'SEO Checker', status: 'Live prototype', href: '/experiments/seo-checker/' },
	{ number: '003', title: 'AI Ready Check', status: 'Live prototype', href: '/experiments/ai-ready-check/' },
	{ number: '004', title: 'Site Intelligence AI', status: 'Live prototype', href: '/experiments/site-intelligence/' },
];

const radarSteps = ['Seed', 'Evidence', 'Opportunity', 'Experiment', 'Decision'];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Demand Radar | AI Factory</title>
		<meta name="description" content="Demand Radar is AI Factory's transparent research log for discovering and validating opportunities through evidence and experiments." />
	</head>
	<body>
		<div class="radar-page">
			<Navigation meta="Research system · 006" current="/radar/" />

			<main>
				<section class="radar-hero" aria-labelledby="radar-title">
					<div class="hero-copy">
						<p class="eyebrow"><span class="signal-dot"></span> Transparent research log</p>
						<h1 id="radar-title">Demand Radar</h1>
						<p class="hero-lede">Finding opportunities through evidence, experiments, and validation.</p>
						<p class="hero-body">AI Factory does not start with ideas.<br />It starts with signals.</p>
					</div>
					<div class="hero-stamp" aria-label="Demand Radar principles">
						<div class="stamp-top"><span>AI FACTORY</span><span>RADAR / M1</span></div>
						<div class="stamp-center"><span>NO</span><strong>ASSUMPTIONS</strong><span>WITHOUT</span><strong>EVIDENCE</strong></div>
						<div class="stamp-bottom"><span>HUMAN DECIDES</span><span>2026</span></div>
					</div>
				</section>

				<section class="statement-band" aria-label="Demand Radar method">
					<p>Signals become <strong>evidence.</strong><br />Evidence becomes <strong>experiments.</strong><br />Experiments decide what deserves <strong>investment.</strong></p>
					<span class="band-label">/ the operating belief</span>
				</section>

				<section class="section current-section" aria-labelledby="current-title">
					<div class="section-heading">
						<div><p class="section-label">01 / Current research</p><h2 id="current-title">One opportunity in view.</h2></div>
						<p class="section-aside">The radar is intentionally small.<br />A thin signal stays a thin signal.</p>
					</div>
					<article class="opportunity-card">
						<div class="opportunity-top"><span class="opportunity-id">OPP-001</span><span class="watch-badge"><i></i>Watch</span></div>
						<div class="opportunity-main">
							<div class="opportunity-title"><p class="card-label">Opportunity</p><h3>Agent session/context workflow tooling</h3><p>Tooling for power users running multiple AI coding-agent sessions on Linux and WSL.</p></div>
							<div class="score-block"><span class="score-number">41</span><span class="score-denom">/100</span><span class="score-label">Watch</span></div>
						</div>
						<div class="opportunity-metrics"><div><span>Confidence</span><strong>Low</strong></div><div><span>Evidence coverage</span><strong>6 / 8</strong></div><div><span>Independent sources</span><strong>4</strong></div><div><span>Freshness</span><strong>Mixed</strong></div></div>
						<div class="decision-note"><span class="note-mark">!</span><div><strong>No build decision has been made.</strong><p>The evidence shows real but sparse pain, strong competition, and no observed paid demand. Human review is still pending.</p></div></div>
					</article>
				</section>

				<section class="method-section" aria-labelledby="method-title">
					<div class="method-copy"><p class="section-label">02 / The method</p><h2 id="method-title">From signal <br />to decision.</h2><p>Every opportunity moves through the same visible chain. Missing evidence is allowed. Confidence stays low when it should.</p></div>
					<div class="method-flow" aria-label="Demand Radar process">{radarSteps.map((step, index) => <div class="method-step"><span>{String(index + 1).padStart(2, '0')}</span><strong>{step}</strong>{index < radarSteps.length - 1 && <i aria-hidden="true">-&gt;</i>}</div>)}</div>
				</section>

				<section class="section experiments-section" aria-labelledby="experiments-title">
					<div class="section-heading"><div><p class="section-label">03 / Experiments</p><h2 id="experiments-title">Research becomes real.</h2></div><p class="section-aside">Small bets with explicit questions.<br />Public records of what happened.</p></div>
					<div class="experiment-list">{experiments.map((experiment) => <a class="experiment-row" href={experiment.href}><span class="experiment-number">EXP {experiment.number}</span><strong>{experiment.title}</strong><span class="experiment-status">{experiment.status}</span><span class="experiment-arrow" aria-hidden="true">-&gt;</span></a>)}</div>
				</section>

				<section class="honesty-section" aria-labelledby="honesty-title">
					<div><p class="section-label">04 / Research discipline</p><h2 id="honesty-title">A decision system,<br />not a dashboard.</h2></div>
					<div class="honesty-copy"><p>Demand Radar is evidence-as-code: research lives in versioned Markdown, and the git history is the audit log.</p><p>The score is not science. It is a readable prompt for human judgment. AI assists the process; humans decide what happens next.</p><a class="text-link" href="/">Back to AI Factory <span aria-hidden="true">-&gt;</span></a></div>
				</section>
			</main>

			<Footer label="Demand Radar / public research log" />
		</div>
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(html) { scroll-behavior: smooth; background: #f4f5ef; }
	:global(body) { margin: 0; color: #172522; background: #f4f5ef; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
	:global(a) { color: inherit; }
	.radar-page { overflow: hidden; }
	.site-header, main, .site-footer { width: min(1160px, calc(100% - 64px)); margin: 0 auto; }
	.site-header { display: flex; align-items: center; justify-content: space-between; height: 78px; border-bottom: 1px solid #d4dbd4; }
	.brand { display: inline-flex; align-items: center; gap: 10px; color: #173b32; font-size: 14px; font-weight: 800; text-decoration: none; }.brand-mark { display: grid; place-items: center; width: 31px; height: 31px; color: #f4f5ef; background: #173b32; font: 800 10px ui-monospace, monospace; }.brand-mark.small { width: 24px; height: 24px; font-size: 8px; }
	.header-meta { display: flex; align-items: center; gap: 11px; color: #72837b; font: 10px ui-monospace, monospace; letter-spacing: .1em; text-transform: uppercase; }.header-line { width: 38px; height: 1px; background: #a5b9ac; }
	.eyebrow, .section-label, .card-label { margin: 0; color: #25836a; font: 700 10px/1.3 ui-monospace, monospace; letter-spacing: .14em; text-transform: uppercase; }.eyebrow { display: flex; align-items: center; gap: 9px; margin-bottom: 25px; }.signal-dot { width: 7px; height: 7px; background: #b9d957; border-radius: 50%; box-shadow: 0 0 0 5px rgba(185, 217, 87, .18); }
	.radar-hero { display: grid; grid-template-columns: minmax(0, 1fr) 360px; align-items: center; gap: 90px; min-height: 535px; padding: 70px 0 78px; }.hero-copy h1 { margin: 0; color: #173b32; font-size: clamp(58px, 8vw, 96px); line-height: .94; letter-spacing: -.05em; font-weight: 800; }.hero-lede { max-width: 590px; margin: 26px 0 0; color: #315a4c; font-size: 24px; line-height: 1.25; letter-spacing: -.025em; }.hero-body { margin: 30px 0 0; color: #75857d; font-size: 15px; line-height: 1.75; }
	.hero-stamp { min-height: 350px; padding: 21px; color: #dce9df; background: #173b32; box-shadow: 14px 14px 0 #cbd8cf; }.stamp-top, .stamp-bottom { display: flex; justify-content: space-between; color: #87ac99; font: 10px ui-monospace, monospace; letter-spacing: .1em; }.stamp-top span:last-child, .stamp-bottom span:last-child { color: #b9d957; }.stamp-center { display: grid; gap: 3px; margin-top: 90px; color: #b9d957; font: 10px ui-monospace, monospace; letter-spacing: .12em; }.stamp-center strong { color: #f0f5ed; font-size: 29px; line-height: 1; letter-spacing: -.04em; }.stamp-bottom { margin-top: 92px; }
	.statement-band { display: flex; align-items: end; justify-content: space-between; padding: 28px 0 31px; border-top: 1px solid #d4dbd4; border-bottom: 1px solid #d4dbd4; }.statement-band p { margin: 0; color: #6e8078; font-size: 19px; line-height: 1.35; }.statement-band strong { color: #173b32; }.band-label { color: #87968f; font: 10px ui-monospace, monospace; letter-spacing: .1em; text-transform: uppercase; }
	.section { padding: 112px 0; }.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 30px; }.section-heading h2, .method-copy h2, .honesty-section h2 { margin: 18px 0 0; color: #173b32; font-size: clamp(34px, 5vw, 52px); line-height: 1; letter-spacing: -.055em; }.section-aside { margin: 0; color: #71827b; font-size: 15px; line-height: 1.55; text-align: right; }
	.opportunity-card { margin-top: 58px; padding: 25px 28px 27px; border: 1px solid #ccd8cf; background: #fff; }.opportunity-top { display: flex; justify-content: space-between; color: #82928a; font: 10px ui-monospace, monospace; letter-spacing: .1em; text-transform: uppercase; }.watch-badge { display: flex; align-items: center; gap: 7px; color: #93651e; }.watch-badge i { width: 7px; height: 7px; background: #d4a744; border-radius: 50%; }.opportunity-main { display: flex; justify-content: space-between; gap: 30px; margin-top: 32px; }.opportunity-title { max-width: 650px; }.opportunity-title h3 { margin: 13px 0 10px; color: #173b32; font-size: clamp(25px, 4vw, 39px); line-height: 1.05; letter-spacing: -.045em; }.opportunity-title > p:last-child { margin: 0; color: #71827b; font-size: 14px; line-height: 1.5; }.score-block { display: grid; grid-template-columns: auto auto; align-content: start; min-width: 150px; padding-left: 25px; border-left: 1px solid #e0e7e0; }.score-number { color: #25836a; font-size: 65px; line-height: .85; font-weight: 800; letter-spacing: -.07em; }.score-denom { align-self: end; padding: 0 0 5px 5px; color: #91a29a; font: 12px ui-monospace, monospace; }.score-label { grid-column: 1 / -1; margin: 13px 0 0; color: #a27020; font: 700 10px ui-monospace, monospace; letter-spacing: .1em; text-transform: uppercase; }.opportunity-metrics { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 36px; border-top: 1px solid #e0e7e0; border-bottom: 1px solid #e0e7e0; }.opportunity-metrics div { display: grid; gap: 8px; padding: 15px 17px 15px 0; border-right: 1px solid #e0e7e0; }.opportunity-metrics div:not(:first-child) { padding-left: 17px; }.opportunity-metrics div:last-child { border-right: 0; }.opportunity-metrics span { color: #87968f; font: 10px ui-monospace, monospace; text-transform: uppercase; }.opportunity-metrics strong { color: #315a4c; font-size: 14px; }.decision-note { display: flex; gap: 13px; margin-top: 22px; padding: 16px 18px; color: #6f572d; background: #fff8e8; }.note-mark { display: grid; place-items: center; width: 21px; height: 21px; flex: none; color: #fff; background: #c89431; border-radius: 50%; font-weight: 800; }.decision-note strong { font-size: 13px; }.decision-note p { margin: 5px 0 0; color: #89754f; font-size: 12px; line-height: 1.45; }
	.method-section { display: grid; grid-template-columns: .72fr 1.28fr; align-items: center; gap: 90px; padding: 112px max(calc((100vw - 1160px) / 2), 32px); color: #dce9df; background: #173b32; }.method-copy { max-width: 390px; }.method-copy .section-label { color: #b5cf62; }.method-copy h2 { color: #f0f5ed; }.method-copy > p:last-child { margin: 25px 0 0; color: #8fb29e; font-size: 14px; line-height: 1.6; }.method-flow { display: grid; grid-template-columns: repeat(5, 1fr); border-top: 1px solid #4b7765; border-bottom: 1px solid #4b7765; }.method-step { position: relative; display: grid; gap: 29px; min-height: 145px; padding: 18px 12px 18px 0; border-right: 1px solid #4b7765; }.method-step:not(:first-child) { padding-left: 12px; }.method-step:last-child { border-right: 0; }.method-step span { color: #b5cf62; font: 10px ui-monospace, monospace; }.method-step strong { align-self: end; color: #f0f5ed; font-size: 13px; }.method-step i { position: absolute; top: 50%; right: -7px; z-index: 1; color: #b5cf62; background: #173b32; font: normal 11px ui-monospace, monospace; }
	.experiment-list { margin-top: 56px; border-top: 1px solid #ccd8cf; }.experiment-row { display: grid; grid-template-columns: 100px 1fr 170px 25px; align-items: center; gap: 15px; min-height: 76px; border-bottom: 1px solid #ccd8cf; color: #315a4c; text-decoration: none; }.experiment-row:hover strong { color: #25836a; }.experiment-number, .experiment-status { color: #82928a; font: 10px ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }.experiment-row strong { font-size: 16px; }.experiment-status { text-align: right; }.experiment-arrow { color: #25836a; font-size: 18px; text-align: right; }
	.honesty-section { display: grid; grid-template-columns: 1fr 1fr; gap: 90px; padding: 112px max(calc((100vw - 1160px) / 2), 32px); color: #dce9df; background: #173b32; }.honesty-section .section-label { color: #c8df61; }.honesty-section h2 { color: #f0f5ed; }.honesty-copy { max-width: 460px; color: #c4d9ca; font-size: 15px; line-height: 1.6; }.honesty-copy p { margin: 0 0 18px; }.text-link { display: inline-flex; gap: 15px; margin-top: 12px; color: #d4eb73; font: 700 12px ui-monospace, monospace; text-decoration: none; }.text-link:hover { color: #fff; }
	.site-footer { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding: 23px 0 30px; border-top: 1px solid #d4dbd4; color: #819089; font: 10px ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }.site-footer > div { display: flex; align-items: center; gap: 8px; color: #315a4c; font-weight: 800; }.site-footer a { color: #25836a; text-decoration: none; }
	@media (max-width: 880px) { .radar-hero { grid-template-columns: 1fr; gap: 50px; }.hero-stamp { max-width: 500px; width: 100%; }.method-section, .honesty-section { grid-template-columns: 1fr; gap: 48px; } }
	@media (max-width: 650px) { .site-header, main, .site-footer { width: min(100% - 34px, 1160px); }.site-header { height: 66px; }.header-meta span:first-child, .header-line { display: none; }.radar-hero { min-height: 0; padding: 64px 0 68px; }.hero-copy h1 { font-size: 62px; }.hero-lede { font-size: 20px; }.hero-stamp { min-height: 315px; box-shadow: 9px 9px 0 #cbd8cf; }.stamp-center { margin-top: 75px; }.stamp-bottom { margin-top: 75px; }.statement-band { align-items: start; flex-direction: column; gap: 18px; }.section { padding: 78px 0; }.section-heading { align-items: start; flex-direction: column; gap: 16px; }.section-aside { text-align: left; }.opportunity-card { padding: 20px; }.opportunity-main { align-items: start; flex-direction: column; gap: 25px; }.score-block { padding: 0; border: 0; }.opportunity-metrics { grid-template-columns: repeat(2, 1fr); }.opportunity-metrics div:nth-child(2) { border-right: 0; }.opportunity-metrics div:nth-child(3) { padding-left: 0; border-top: 1px solid #e0e7e0; }.opportunity-metrics div:nth-child(4) { border-top: 1px solid #e0e7e0; }.method-section, .honesty-section { padding: 78px 17px; }.method-flow { grid-template-columns: repeat(5, 1fr); }.method-step { min-height: 113px; padding-right: 5px; }.method-step:not(:first-child) { padding-left: 5px; }.method-step strong { font-size: 10px; overflow-wrap: anywhere; }.method-step i { display: none; }.experiment-row { grid-template-columns: 67px 1fr 20px; gap: 9px; min-height: 82px; }.experiment-status { grid-column: 2; grid-row: 2; text-align: left; }.experiment-arrow { grid-column: 3; grid-row: 1 / 3; }.honesty-copy { font-size: 14px; }.site-footer { align-items: start; flex-direction: column; } }
	@media (max-width: 410px) { .hero-copy h1 { font-size: 55px; }.hero-stamp { min-height: 285px; }.stamp-center { margin-top: 60px; }.stamp-bottom { margin-top: 62px; }.stamp-center strong { font-size: 25px; } }
</style>
