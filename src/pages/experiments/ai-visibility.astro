---
import '../../styles/global.css';
import Navigation from '../../components/design/Navigation.astro';
import Footer from '../../components/design/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>AI Search Visibility Audit | AI Factory</title>
		<meta name="description" content="Audit the public signals that help AI systems discover, understand and reference your website." />
	</head>
	<body>
		<div class="page-shell">
			<Navigation meta="Experiment 008 · AI Search Visibility Audit" />

			<main>
				<section class="hero" aria-labelledby="page-title">
					<div class="hero-copy">
						<p class="eyebrow">AI Search Visibility Audit</p>
						<h1 id="page-title">See how ready your website is for AI search.</h1>
						<p class="hero-subtitle">A transparent audit of the public signals that help modern AI systems discover, understand and reference your brand.</p>
						<form id="audit-form" novalidate aria-label="AI visibility audit">
							<div class="input-grid">
								<div class="field field-wide"><label for="url">Website URL</label><input id="url" name="url" type="text" inputmode="url" autocomplete="url" spellcheck="false" required placeholder="example.com" /></div>
								<div class="field"><label for="brand-name">Brand name <span>(optional)</span></label><input id="brand-name" name="brandName" type="text" autocomplete="organization" maxlength="120" placeholder="Your organization" /></div>
							</div>
							<button id="submit-button" type="submit">Analyze AI Visibility <span aria-hidden="true">-&gt;</span></button>
							<p class="input-note">One homepage plus three discovery files. No crawling, accounts, external APIs or stored data.</p>
						</form>
					</div>
					<div class="hero-panel" aria-label="Audit scope">
						<div class="panel-label"><span class="pulse-dot" aria-hidden="true"></span> Public signal audit</div>
						<div class="orbit" aria-hidden="true"><span class="orbit-line orbit-line-one"></span><span class="orbit-line orbit-line-two"></span><span class="orbit-core">AI<br />SEARCH</span><span class="orbit-word orbit-word-top">CRAWL</span><span class="orbit-word orbit-word-right">ENTITY</span><span class="orbit-word orbit-word-bottom">CITE</span></div>
						<div class="panel-footer"><span>0-100 score</span><span class="panel-rule"></span><span>Deterministic</span></div>
					</div>
				</section>

				<section class="scope-strip" aria-label="Audit scope summary"><span><b>40</b> crawlability</span><span><b>30</b> entity authority</span><span><b>30</b> citation readiness</span><span><b>0</b> LLM calls</span></section>

				<div id="state-loading" class="state-box loading-box" role="status" hidden><span class="loader" aria-hidden="true"></span><div><strong>Reading public signals</strong><p>Checking the homepage, access rules and discovery files.</p></div></div>
				<div id="state-error" class="state-box error-box" role="alert" hidden><span class="state-icon" aria-hidden="true">!</span><div><strong>Could not complete the audit</strong><p id="error-message"></p></div></div>

				<section id="state-results" class="results" aria-live="polite" aria-labelledby="results-title" hidden>
					<div class="results-header"><div><p class="eyebrow">Audit complete</p><h2 id="results-title">AI visibility report</h2><p id="analyzed-site" class="muted"></p></div><button id="new-audit" class="text-button" type="button">Analyze another <span aria-hidden="true">-&gt;</span></button></div>
					<div class="score-banner"><div><p class="eyebrow inverse">AI visibility score</p><div class="score-number"><span id="overall-score">--</span><small>/ 100</small></div><p id="score-label" class="score-label"></p><p id="score-summary" class="score-summary"></p></div><div id="section-scores" class="section-scores"></div></div>
					<div id="report-sections" class="report-sections"></div>
					<div class="honest-note"><strong>Read this score carefully.</strong><span>It measures public preparation signals only. It does not predict whether an AI platform will recommend, rank, cite or send traffic to a website. No LLM is involved and no result is stored.</span></div>
				</section>
			</main>

			<Footer label="Experiment 008 · AI Search Visibility Audit" />
		</div>

		<script>
			type Status = 'pass' | 'warn' | 'fail';
			interface Item { id: string; label: string; status: Status; points: number; maxPoints: number; detail: string; problem: string; why: string; suggestion: string; }
			interface Section { id: string; label: string; earned: number; max: number; items: Item[]; }
			interface Report { url: string; finalUrl: string; brandName: string | null; checkedAt: string; requests: number; score: { total: number; max: number; label: string }; sections: Section[]; }
			interface ApiSuccess { ok: true; report: Report; }
			interface ApiFailure { ok: false; error: string; }

			const form = document.getElementById('audit-form') as HTMLFormElement | null;
			const urlInput = document.getElementById('url') as HTMLInputElement | null;
			const brandInput = document.getElementById('brand-name') as HTMLInputElement | null;
			const submitButton = document.getElementById('submit-button') as HTMLButtonElement | null;
			const loading = document.getElementById('state-loading');
			const errorBox = document.getElementById('state-error');
			const results = document.getElementById('state-results');
			const errorMessage = document.getElementById('error-message');

			function node<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string): HTMLElementTagNameMap[K] {
				const element = document.createElement(tag);
				if (className) element.className = className;
				if (text !== undefined) element.textContent = text;
				return element;
			}

			function show(active: HTMLElement | null): void {
				for (const element of [loading, errorBox, results]) {
					if (!element) continue;
					if (element === active) element.removeAttribute('hidden'); else element.setAttribute('hidden', '');
				}
			}

			function statusText(status: Status): string { return status === 'pass' ? 'Pass' : status === 'warn' ? 'Review' : 'Missing'; }

			function renderSection(section: Section): HTMLElement {
				const wrapper = node('section', 'report-section');
				const heading = node('div', 'section-heading');
				const title = node('div');
				title.append(node('p', 'section-kicker', section.id === 'crawlability' ? '01 / access' : section.id === 'authority' ? '02 / identity' : '03 / evidence'), node('h3', undefined, section.label));
				heading.append(title, node('span', 'section-score', `${section.earned} / ${section.max}`));
				wrapper.append(heading);
				const list = node('div', 'item-list');
				for (const item of section.items) {
					const row = node('div', `audit-item item-${item.status}`);
					const top = node('div', 'item-top');
					top.append(node('span', `status-dot status-${item.status}`, item.status === 'pass' ? 'OK' : item.status === 'warn' ? '!' : 'NO'), node('strong', undefined, item.label), node('span', 'item-status', statusText(item.status)));
					row.append(top, node('p', 'item-detail', item.detail));
					if (item.status !== 'pass') {
						const issue = node('div', 'issue');
						issue.append(node('strong', undefined, 'Problem'), node('p', undefined, item.problem), node('strong', undefined, 'Why it matters'), node('p', undefined, item.why), node('strong', undefined, 'Suggested improvement'), node('p', undefined, item.suggestion));
						row.append(issue);
					}
					list.append(row);
				}
				wrapper.append(list);
				return wrapper;
			}

			function render(report: Report): void {
				const overall = document.getElementById('overall-score');
				const label = document.getElementById('score-label');
				const summary = document.getElementById('score-summary');
				const analyzed = document.getElementById('analyzed-site');
				if (overall) overall.textContent = String(report.score.total);
				if (label) label.textContent = report.score.label;
				const issueCount = report.sections.flatMap((section) => section.items).filter((item) => item.status !== 'pass').length;
				if (summary) summary.textContent = issueCount ? `${issueCount} public signal${issueCount === 1 ? '' : 's'} to review.` : 'All checked public signals passed.';
				if (analyzed) analyzed.textContent = `Analyzed ${report.url}${report.finalUrl !== report.url ? ` -> ${report.finalUrl}` : ''}${report.brandName ? ` for ${report.brandName}` : ''}`;
				const scoreBox = document.getElementById('section-scores');
				if (scoreBox) scoreBox.replaceChildren(...report.sections.map((section) => { const row = node('div', 'section-score-row'); const percent = Math.round(section.earned / section.max * 100); row.append(node('span', undefined, section.label), node('b', undefined, `${section.earned} / ${section.max}`)); const track = node('span', 'score-track'); const fill = node('i'); fill.style.width = `${percent}%`; track.append(fill); row.append(track); return row; }));
				const sections = document.getElementById('report-sections');
				if (sections) sections.replaceChildren(...report.sections.map(renderSection));
			}

			async function analyze(): Promise<void> {
				const url = urlInput?.value.trim() ?? '';
				if (!url) { if (errorMessage) errorMessage.textContent = 'Enter a website URL to analyze.'; show(errorBox); return; }
				show(loading);
				if (submitButton) submitButton.disabled = true;
				try {
					const response = await fetch('/api/ai-visibility', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ url, brandName: brandInput?.value.trim() ?? '' }) });
					const data = await response.json() as ApiSuccess | ApiFailure;
					if (!data.ok) { if (errorMessage) errorMessage.textContent = data.error; show(errorBox); return; }
					render(data.report); show(results);
				} catch { if (errorMessage) errorMessage.textContent = 'The audit could not be completed. Please try again.'; show(errorBox); }
				finally { if (submitButton) submitButton.disabled = false; }
			}

			form?.addEventListener('submit', (event) => { event.preventDefault(); void analyze(); });
			document.getElementById('new-audit')?.addEventListener('click', () => { show(null); urlInput?.focus(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
		</script>
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(html) { background: #f1f4f1; }
	:global(body) { margin: 0; color: #18221f; background: #f1f4f1; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
	:global(button), :global(input) { font: inherit; }
	:global(button) { cursor: pointer; }
	.page-shell { min-height: 100vh; overflow: hidden; }
	.topbar, main, footer { width: min(1160px, calc(100% - 48px)); margin: 0 auto; }
	.topbar { height: 78px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #d9e0d9; }
	.brand { display: inline-flex; align-items: center; gap: 10px; color: #18221f; text-decoration: none; font-size: 14px; font-weight: 750; }
	.brand-mark { display: grid; place-items: center; width: 30px; height: 30px; color: #f1f4f1; background: #183d35; font: 700 10px/1 ui-monospace, monospace; }
	.experiment-tag, .eyebrow, .section-kicker, .panel-label, .inverse { font: 700 10px/1.2 ui-monospace, monospace; letter-spacing: .14em; text-transform: uppercase; }
	.experiment-tag { color: #678078; }
	.hero { display: grid; grid-template-columns: minmax(0, 1fr) 390px; align-items: center; gap: 80px; padding: 76px 0 68px; }
	.hero-copy { max-width: 680px; }
	.eyebrow { margin: 0 0 20px; color: #27836c; }
	h1 { max-width: 660px; margin: 0; color: #183d35; font-size: 64px; line-height: 1.02; letter-spacing: -.035em; font-weight: 760; }
	.hero-subtitle { max-width: 570px; margin: 25px 0 30px; color: #5b6c65; font-size: 18px; line-height: 1.55; }
	.input-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 12px; max-width: 640px; }
	.field { display: grid; gap: 7px; }
	.field label { color: #71827a; font: 700 10px ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
	.field label span { color: #9aa8a1; font-weight: 400; letter-spacing: 0; text-transform: none; }
	.field input { width: 100%; min-width: 0; padding: 14px 15px; color: #18221f; border: 1px solid #c9d4cd; outline: 0; background: #fff; box-shadow: 0 6px 16px rgba(28, 57, 46, .05); }
	.field input:focus { border-color: #4c9c7e; box-shadow: 0 0 0 3px rgba(76, 156, 126, .16); }
	.field input::placeholder { color: #a0ada6; }
	#submit-button { margin-top: 17px; padding: 14px 19px; color: #f7fbf7; border: 0; background: #183d35; font-weight: 700; transition: background .2s, transform .2s; }
	#submit-button:hover { background: #276452; transform: translateY(-1px); }
	#submit-button:disabled { cursor: wait; opacity: .6; transform: none; }
	.input-note { margin: 12px 0 0 1px; color: #82928a; font-size: 12px; }
	.hero-panel { min-height: 370px; padding: 25px; color: #e8f1e9; background: #183d35; box-shadow: 18px 18px 0 #c8d7cd; }
	.panel-label { display: flex; align-items: center; gap: 8px; color: #a3c6b4; letter-spacing: .1em; }
	.pulse-dot { width: 7px; height: 7px; background: #d4e86a; border-radius: 50%; box-shadow: 0 0 0 5px rgba(212, 232, 106, .12); }
	.orbit { position: relative; height: 270px; margin-top: 12px; }
	.orbit-line { position: absolute; left: 50%; top: 50%; border: 1px solid #4b7b68; transform: translate(-50%, -50%) rotate(18deg); }
	.orbit-line-one { width: 198px; height: 198px; }
	.orbit-line-two { width: 130px; height: 130px; border-color: #729b87; transform: translate(-50%, -50%) rotate(-27deg); }
	.orbit-core { position: absolute; left: 50%; top: 50%; display: grid; place-items: center; width: 78px; height: 78px; color: #183d35; background: #d4e86a; border-radius: 50%; transform: translate(-50%, -50%); font: 800 12px/1.1 ui-monospace, monospace; text-align: center; }
	.orbit-word { position: absolute; color: #a3c6b4; font: 600 9px ui-monospace, monospace; letter-spacing: .1em; }
	.orbit-word-top { top: 25px; left: 50%; transform: translateX(-50%); }
	.orbit-word-right { right: 8px; top: 50%; transform: translateY(-50%) rotate(90deg); }
	.orbit-word-bottom { bottom: 25px; left: 50%; transform: translateX(-50%); }
	.panel-footer { display: flex; align-items: center; gap: 10px; color: #b6d0c1; font: 11px ui-monospace, monospace; }
	.panel-rule { height: 1px; flex: 1; background: #4a7967; }
	.scope-strip { display: flex; justify-content: space-between; gap: 18px; padding: 19px 0; border-top: 1px solid #d3ddd5; border-bottom: 1px solid #d3ddd5; color: #71827a; font: 11px ui-monospace, monospace; letter-spacing: .05em; text-transform: uppercase; }
	.scope-strip b { margin-right: 6px; color: #27836c; font-size: 14px; }
	.state-box { display: flex; align-items: flex-start; gap: 15px; margin: 42px 0; padding: 22px; border: 1px solid #cedad2; background: #fff; }
	.state-box strong { display: block; font-size: 15px; }
	.state-box p { margin: 7px 0 0; color: #6c7e75; font-size: 13px; line-height: 1.5; }
	.loader { width: 18px; height: 18px; flex: none; border: 2px solid #c8ddd2; border-top-color: #27836c; border-radius: 50%; animation: spin .8s linear infinite; }
	.state-icon { display: grid; place-items: center; width: 20px; height: 20px; flex: none; color: #8b4934; border: 1px solid #d8a795; border-radius: 50%; font-weight: 800; }
	.error-box { border-color: #e0c4b8; background: #fff8f5; }
	.results { padding: 76px 0 80px; }
	.results-header { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
	.results h2 { margin: 0; color: #183d35; font-size: 38px; line-height: 1.1; letter-spacing: -.025em; }
	.muted { max-width: 760px; margin: 10px 0 0; color: #788880; font-size: 13px; overflow-wrap: anywhere; }
	.text-button { padding: 10px 0; color: #27836c; border: 0; border-bottom: 1px solid #8ab7a4; background: transparent; font-size: 13px; font-weight: 700; }
	.score-banner { display: grid; grid-template-columns: .9fr 1.1fr; gap: 50px; padding: 35px; color: #e8f1e9; background: #183d35; }
	.inverse { color: #a3c6b4; }
	.score-number { margin-top: 15px; color: #d4e86a; font-size: 72px; line-height: .9; font-weight: 760; letter-spacing: -.05em; }
	.score-number small { margin-left: 7px; color: #a3c6b4; font-size: 18px; letter-spacing: 0; }
	.score-label { margin: 14px 0 0; color: #fff; font-size: 16px; font-weight: 700; }
	.score-summary { margin: 8px 0 0; color: #a3c6b4; font-size: 13px; }
	.section-scores { align-self: end; }
	.section-score-row { display: grid; grid-template-columns: 1fr auto; gap: 10px 16px; margin-top: 18px; color: #d7e8dc; font-size: 13px; }
	.section-score-row b { color: #fff; }
	.score-track { grid-column: 1 / -1; display: block; height: 5px; background: #315b4b; }
	.score-track i { display: block; width: 0; height: 100%; background: #d4e86a; transition: width .5s ease; }
	.report-sections { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 20px; }
	.report-section { min-width: 0; padding: 25px; border: 1px solid #d4ded6; background: #fff; }
	.section-heading { display: flex; align-items: start; justify-content: space-between; gap: 12px; min-height: 61px; }
	.section-kicker { margin: 0 0 9px; color: #82948b; font-size: 9px; }
	.report-section h3 { margin: 0; color: #183d35; font-size: 22px; letter-spacing: -.02em; }
	.section-score { color: #27836c; font: 700 12px ui-monospace, monospace; white-space: nowrap; }
	.item-list { border-top: 1px solid #e2e9e3; }
	.audit-item { padding: 15px 0; border-bottom: 1px solid #e2e9e3; }
	.item-top { display: flex; align-items: center; gap: 9px; }
	.status-dot { display: grid; place-items: center; width: 24px; height: 24px; flex: none; border-radius: 50%; font: 800 8px ui-monospace, monospace; }
	.status-pass { color: #1e725a; background: #e1f2e8; }
	.status-warn { color: #96651e; background: #fff0ce; }
	.status-fail { color: #984932; background: #f9e3dc; }
	.item-top strong { min-width: 0; flex: 1; color: #24352e; font-size: 12px; }
	.item-status { color: #7a8b83; font: 700 9px ui-monospace, monospace; text-transform: uppercase; }
	.item-detail { margin: 7px 0 0 33px; color: #7a8b83; font-size: 11px; line-height: 1.45; overflow-wrap: anywhere; }
	.issue { margin: 12px 0 0 33px; padding: 12px; border-left: 2px solid #e4c47b; background: #fffaf0; }
	.issue strong { display: block; margin-top: 9px; color: #6f541d; font: 700 9px ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
	.issue strong:first-child { margin-top: 0; }
	.issue p { margin: 4px 0 0; color: #75684d; font-size: 11px; line-height: 1.45; }
	.honest-note { display: grid; grid-template-columns: auto 1fr; gap: 16px; margin-top: 20px; padding: 21px 24px; border: 1px dashed #b9c9bf; color: #66776e; font-size: 12px; line-height: 1.5; }
	.honest-note strong { color: #183d35; }
	footer { display: flex; justify-content: space-between; gap: 15px; padding: 23px 0 30px; border-top: 1px solid #d3ddd5; color: #82928a; font: 10px ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
	@keyframes spin { to { transform: rotate(360deg); } }
	@media (max-width: 900px) { .hero { grid-template-columns: 1fr; gap: 50px; } .hero-panel { max-width: 500px; } .report-sections { grid-template-columns: 1fr; } }
	@media (max-width: 620px) { .topbar, main, footer { width: min(100% - 32px, 1160px); } .topbar { height: 66px; } .experiment-tag { font-size: 9px; } h1 { font-size: 46px; } .hero { padding: 58px 0 53px; } .hero-subtitle { font-size: 16px; } .input-grid { grid-template-columns: 1fr; } #submit-button { width: 100%; } .scope-strip { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; } .hero-panel { box-shadow: 10px 10px 0 #c8d7cd; } .results { padding-top: 54px; } .results-header { align-items: start; flex-direction: column; } .results h2 { font-size: 31px; } .score-banner { grid-template-columns: 1fr; gap: 24px; padding: 24px; } .score-number { font-size: 63px; } .report-section { padding: 22px; } .honest-note { grid-template-columns: 1fr; gap: 8px; } footer { flex-direction: column; } }
</style>
