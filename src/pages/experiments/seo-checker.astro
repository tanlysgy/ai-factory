---
import '../../styles/global.css';
import Navigation from '../../components/design/Navigation.astro';
import Footer from '../../components/design/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>SEO Checker — analyze your website quickly | AI Factory</title>
		<meta
			name="description"
			content="Paste a URL and get a quick read on title, meta description, headings, links and page technology. A small AI Factory experiment."
		/>
	</head>
	<body class="bg-[#f4f5ef] text-[#172522] antialiased">
		<Navigation meta="Experiment 002 · SEO Checker" />
		<main class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
			<header>
				<p class="font-mono text-xs uppercase tracking-widest text-[#71827b]">
					AI Factory · Experiment 002
				</p>
				<h1 class="mt-6 text-[44px] font-bold leading-[1.06] tracking-[-0.03em]">
					Analyze your website quickly.
				</h1>
				<p class="mt-5 max-w-xl text-lg leading-relaxed text-[#64756e]">
					Paste a URL. We fetch that one page and show you the basics that shape how it
					appears to search engines and to people.
				</p>
			</header>

			<section class="mt-10" aria-labelledby="checker-heading">
				<h2 id="checker-heading" class="sr-only">Run a check</h2>
				<form id="seo-form" class="space-y-4" novalidate aria-label="Website SEO check">
					<div class="flex flex-col gap-3 sm:flex-row">
						<label for="url" class="sr-only">Website URL</label>
						<input
							id="url"
							name="url"
							type="text"
							inputmode="url"
							autocomplete="url"
							spellcheck="false"
							required
							placeholder="example.com"
							class="w-full flex-1 rounded-none border border-[#173b32] bg-white px-4 py-3 text-sm placeholder:text-[#91a29a] focus:outline-none focus:ring-2 focus:ring-[#173b32] ring-[#173b32]/15"
						/>
						<button
							id="submit-button"
							type="submit"
							class="shrink-0 rounded-none bg-[#173b32] px-6 py-3 text-sm font-medium text-white shadow-[4px_4px_0_rgba(23,59,50,0.14)] transition-colors hover:bg-[#315a4c] disabled:cursor-not-allowed disabled:opacity-60"
						>
							Analyze website
						</button>
					</div>
					<p class="text-xs text-[#91a29a]">
						One page, fetched once. No crawling, no account, nothing stored. Try{` `}
						<button
							type="button"
							id="sample-button"
							class="underline decoration-dotted underline-offset-2 hover:text-[#64756e]"
						>example.com</button>.
					</p>
				</form>
			</section>

			<div id="state-loading" class="mt-10 rounded-none border border-[#173b32] bg-white p-6" role="status" hidden>
				<p class="text-sm text-[#64756e]">Fetching and analyzing that page…</p>
			</div>

			<div id="state-error" class="mt-10 rounded-none border border-[#d98a6f] bg-[#f7e9e2] p-6" role="alert" hidden>
				<h3 class="text-sm font-medium text-[#a5533a]">Could not analyze that URL</h3>
				<p id="error-message" class="mt-2 text-sm text-[#8a4431]"></p>
			</div>

			<section id="state-results" class="mt-10" aria-live="polite" aria-labelledby="results-heading" hidden>
				<h2 id="results-heading" class="text-2xl font-semibold tracking-tight">Results</h2>
				<p id="result-summary" class="mt-2 text-sm text-[#71827b]"></p>
				<p id="result-analyzed" class="mt-1 text-sm text-[#64756e]"></p>

				<div id="result-overview" class="mt-6 grid gap-4 sm:grid-cols-3"></div>

				<div id="result-checks" class="mt-6 rounded-none border border-[#173b32] bg-white p-6"></div>

				<div id="result-content" class="mt-6 rounded-none border border-[#173b32] bg-white p-6"></div>

				<div id="result-links" class="mt-6 rounded-none border border-[#173b32] bg-white p-6"></div>
			</section>

			<section class="mt-16">
				<div class="rounded-none border border-dashed border-[#173b32] bg-[#eef3eb] p-6">
					<h2 class="font-mono text-xs uppercase tracking-widest text-[#71827b]">Honest note</h2>
					<p class="mt-3 text-sm leading-relaxed text-[#64756e]">
						This is an AI Factory experiment testing whether we can build and ship a small
						useful tool quickly. It fetches a single public page and reports what that page
						says about itself — it is not a crawler, a backlink index, or an SEO audit. Nothing
						you enter is stored.
					</p>
				</div>
			</section>
		</main>

		<Footer label="Experiment 002 · SEO checker prototype" />

		<script>
			import { track } from '../../lib/track';

			type CheckStatus = 'pass' | 'warn' | 'fail';

			interface Analysis {
				url: string;
				finalUrl: string;
				status: number;
				bytes: number;
				title: string | null;
				metaDescription: string | null;
				canonical: string | null;
				lang: string | null;
				h1: string[];
				imageCount: number;
				imagesMissingAlt: number;
				hasViewport: boolean;
				openGraphTags: number;
				techHints: string[];
				checks: Array<{ id: string; label: string; status: CheckStatus; detail: string }>;
				links: Array<{ href: string; text: string; internal: boolean }>;
				linksTruncated: boolean;
				linkCount: number;
				fetchedAt: string;
			}

			const form = document.getElementById('seo-form') as HTMLFormElement | null;
			const input = document.getElementById('url') as HTMLInputElement | null;
			const button = document.getElementById('submit-button') as HTMLButtonElement | null;
			const idle = document.getElementById('state-loading');
			const errorBox = document.getElementById('state-error');
			const errorMessage = document.getElementById('error-message');
			const results = document.getElementById('state-results');

			function el<K extends keyof HTMLElementTagNameMap>(
				tag: K,
				className?: string,
				text?: string,
			): HTMLElementTagNameMap[K] {
				const node = document.createElement(tag);
				if (className) node.className = className;
				if (text !== undefined) node.textContent = text;
				return node;
			}

			function show(active: HTMLElement | null): void {
				for (const node of [idle, errorBox, results]) {
					if (!node) continue;
					if (node === active) node.removeAttribute('hidden');
					else node.setAttribute('hidden', '');
				}
			}

			function formatBytes(bytes: number): string {
				if (bytes < 1024) return `${bytes} B`;
				if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
				return `${(bytes / 1024 / 1024).toFixed(2)} MB`;
			}

			function overviewCard(label: string, value: string, hint?: string): HTMLElement {
				const card = el('div', 'rounded-none border border-[#173b32] bg-white p-5');
				card.append(el('p', 'text-xs uppercase tracking-wide text-[#71827b]', label));
				card.append(el('p', 'mt-2 text-[32px] font-bold tracking-[-0.03em]', value));
				if (hint) card.append(el('p', 'mt-1 text-xs text-[#71827b]', hint));
				return card;
			}

			const statusStyles: Record<CheckStatus, { dot: string; text: string }> = {
				pass: { dot: 'bg-[#b9d957]', text: 'text-[#315a4c]' },
				warn: { dot: 'bg-[#c89431]', text: 'text-[#93651e]' },
				fail: { dot: 'bg-[#d98a6f]', text: 'text-[#a5533a]' },
			};

			function renderResults(analysis: Analysis): void {
				const summary = document.getElementById('result-summary');
				if (summary) {
					const passed = analysis.checks.filter((c) => c.status === 'pass').length;
					summary.textContent = `${passed} of ${analysis.checks.length} checks passed · HTTP ${analysis.status} · ${formatBytes(analysis.bytes)} of HTML · fetched ${new Date(analysis.fetchedAt).toLocaleString()}`;
				}

				const overview = document.getElementById('result-overview');
				if (overview) {
					overview.replaceChildren(
						overviewCard(
							'Links found',
							String(analysis.linkCount),
							`${analysis.links.filter((l) => l.internal).length} unique internal shown`,
						),
						overviewCard('H1 headings', String(analysis.h1.length)),
						overviewCard('Images', String(analysis.imageCount), analysis.imagesMissingAlt > 0 ? `${analysis.imagesMissingAlt} missing alt` : 'all have alt text'),
					);
				}

				const analyzedBox = document.getElementById('result-analyzed');
				if (analyzedBox) {
					const analyzed = el('span');
					analyzed.append(el('span', 'text-[#71827b]', 'Analyzed: '));
					const link = el('a', 'font-medium text-[#173b32] underline underline-offset-2 break-all', analysis.url);
					link.setAttribute('href', analysis.url);
					link.setAttribute('rel', 'nofollow noopener noreferrer');
					link.setAttribute('target', '_blank');
					analyzed.append(link);
					if (analysis.finalUrl !== analysis.url) {
						analyzed.append(el('span', 'text-[#71827b]', ` → redirected to ${analysis.finalUrl}`));
					}
					analyzedBox.replaceChildren(analyzed);
				}

				const checksBox = document.getElementById('result-checks');
				if (checksBox) {
					checksBox.replaceChildren(el('h3', 'text-sm font-medium', 'Checks'));
					const list = el('ul', 'mt-4 space-y-3');
					for (const check of analysis.checks) {
						const style = statusStyles[check.status] ?? statusStyles.warn;
						const item = el('li', 'flex items-start gap-3');
						item.append(el('span', `mt-1.5 h-2 w-2 shrink-0 rounded-full ${style.dot}`));
						const body = el('div');
						body.append(el('p', `text-sm font-medium ${style.text}`, check.label));
						body.append(el('p', 'text-sm text-[#64756e]', check.detail));
						item.append(body);
						list.append(item);
					}
					checksBox.append(list);
				}

				const contentBox = document.getElementById('result-content');
				if (contentBox) {
					contentBox.replaceChildren(el('h3', 'text-sm font-medium', 'Page content'));
					const rows: Array<[string, string]> = [
						['Title', analysis.title ?? '— none found'],
						['Meta description', analysis.metaDescription === null ? '— none found' : analysis.metaDescription || '— empty'],
						['Canonical', analysis.canonical ?? '— none'],
						['Language', analysis.lang ?? '— not set'],
						['Open Graph tags', String(analysis.openGraphTags)],
						['Detected technology', analysis.techHints.length ? analysis.techHints.join(', ') : '— no common signatures found'],
					];
					const list = el('dl', 'mt-4 space-y-3');
					for (const [label, value] of rows) {
						const row = el('div', 'sm:grid sm:grid-cols-[10rem_1fr] sm:gap-4');
						row.append(el('dt', 'text-xs uppercase tracking-wide text-[#71827b]', label));
						row.append(el('dd', 'mt-0.5 text-sm text-[#172522] break-words sm:mt-0', value));
						list.append(row);
					}
					contentBox.append(list);

					if (analysis.h1.length) {
						contentBox.append(el('h3', 'mt-6 text-sm font-medium', 'H1 headings'));
						const headings = el('ul', 'mt-2 space-y-1');
						for (const heading of analysis.h1) {
							headings.append(el('li', 'text-sm text-[#315a4c]', heading));
						}
						contentBox.append(headings);
					}
				}

				const linksBox = document.getElementById('result-links');
				if (linksBox) {
					linksBox.replaceChildren(
						el(
							'h3',
							'text-sm font-medium',
							`Links on the page — showing ${analysis.links.length} of ${analysis.linkCount}${analysis.linksTruncated ? ' (capped at 25)' : ''}, duplicates collapsed`,
						),
					);
					if (!analysis.links.length) {
						linksBox.append(el('p', 'mt-2 text-sm text-[#71827b]', 'No followable links found.'));
					} else {
						const list = el('ul', 'mt-4 space-y-2');
						for (const item of analysis.links) {
							const li = el('li', 'flex items-start gap-2 text-sm');
							li.append(
								el(
									'span',
									`shrink-0 rounded px-1.5 py-0.5 text-[10px] uppercase tracking-wide ${item.internal ? 'bg-[#eef5e0] text-[#315a4c]' : 'bg-[#eef3eb] text-[#71827b]'}`,
									item.internal ? 'internal' : 'external',
								),
							);
							const anchor = el('a', 'text-[#173b32] underline underline-offset-2 break-all', item.text || item.href);
							anchor.setAttribute('href', item.href);
							anchor.setAttribute('rel', 'nofollow noopener noreferrer');
							anchor.setAttribute('target', '_blank');
							li.append(anchor);
							list.append(li);
						}
						linksBox.append(list);
					}
				}
			}

			async function analyze(rawUrl: string): Promise<void> {
				show(idle);
				if (button) button.disabled = true;
				try {
					const response = await fetch('/api/analyze', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({ url: rawUrl }),
					});
					const data = (await response.json()) as
						| { ok: true; analysis: Analysis }
						| { ok: false; error: string };

					if (!data.ok) {
						if (errorMessage) errorMessage.textContent = data.error;
						show(errorBox);
						track('seo_check_error', { reason: data.error });
						return;
					}
					renderResults(data.analysis);
					show(results);
					track('seo_check_result', {
						status: data.analysis.status,
						passed: data.analysis.checks.filter((c) => c.status === 'pass').length,
						failed: data.analysis.checks.filter((c) => c.status === 'fail').length,
					});
				} catch {
					if (errorMessage) {
						errorMessage.textContent = 'The check could not be completed. Please try again.';
					}
					show(errorBox);
					track('seo_check_error', { reason: 'network' });
				} finally {
					if (button) button.disabled = false;
				}
			}

			form?.addEventListener('submit', (event) => {
				event.preventDefault();
				const value = input?.value.trim() ?? '';
				if (!value) {
					input?.focus();
					return;
				}
				track('seo_check_submit');
				void analyze(value);
			});

			document.getElementById('sample-button')?.addEventListener('click', () => {
				if (!input) return;
				input.value = 'example.com';
				input.focus();
			});
		</script>
	</body>
</html>
