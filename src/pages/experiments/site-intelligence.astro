---
import '../../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Site Intelligence AI | AI Factory</title>
		<meta
			name="description"
			content="Analyze your website for AI visibility and technical health with a fast, transparent report."
		/>
	</head>
	<body>
		<div class="site-shell">
			<header class="topbar">
				<a class="brand" href="/" aria-label="AI Factory home">
					<span class="brand-mark" aria-hidden="true">AF</span>
					<span>AI Factory</span>
				</a>
				<span class="experiment-tag">Experiment 004</span>
			</header>

			<main>
				<section class="hero" aria-labelledby="page-title">
					<div class="hero-copy">
						<p class="eyebrow">Site Intelligence AI</p>
						<h1 id="page-title">Analyze your website for AI visibility and technical health.</h1>
						<p class="hero-subtitle">
							Get an instant report showing how discoverable your website is to modern search and AI systems.
						</p>
						<form id="intelligence-form" novalidate aria-label="Site intelligence analysis">
							<label for="url" class="sr-only">Website URL</label>
							<div class="input-row">
								<input
									id="url"
									name="url"
									type="text"
									inputmode="url"
									autocomplete="url"
									spellcheck="false"
									required
									placeholder="example.com"
								/>
								<button id="submit-button" type="submit">Analyze <span aria-hidden="true">-&gt;</span></button>
							</div>
							<p class="input-note">One homepage, robots.txt, sitemap and llms.txt. No account. Nothing stored.</p>
						</form>
					</div>

					<div class="hero-panel" aria-label="Report preview">
						<div class="panel-topline"><span class="pulse-dot"></span> Intelligence snapshot</div>
						<div class="signal-map" aria-hidden="true">
							<div class="signal-ring signal-ring-one"></div>
							<div class="signal-ring signal-ring-two"></div>
							<div class="signal-core">AI<br />+ SEO</div>
							<span class="signal-label label-top">DISCOVERABILITY</span>
							<span class="signal-label label-right">MACHINE READABILITY</span>
							<span class="signal-label label-bottom">TECHNICAL HEALTH</span>
						</div>
						<div class="preview-footer"><span>One URL</span><span class="preview-line"></span><span>One clear report</span></div>
					</div>
				</section>

				<section class="trust-strip" aria-label="Analysis boundaries">
					<span><strong>05</strong> bounded requests</span>
					<span><strong>100</strong> point scoring</span>
					<span><strong>0</strong> external APIs</span>
					<span><strong>0</strong> data stored</span>
				</section>

				<div id="state-loading" class="state-box loading-box" role="status" hidden>
					<span class="loader" aria-hidden="true"></span>
					<div><strong>Reading your public signals</strong><p>Checking the homepage, access rules and discovery files.</p></div>
				</div>

				<div id="state-error" class="state-box error-box" role="alert" hidden>
					<div class="state-icon" aria-hidden="true">!</div>
					<div><strong>Could not analyze that URL</strong><p id="error-message"></p></div>
				</div>

				<section id="state-results" class="results" aria-live="polite" aria-labelledby="results-heading" hidden>
					<div class="results-heading-row">
						<div>
							<p class="eyebrow">Report ready</p>
							<h2 id="results-heading">Your site intelligence report</h2>
							<p id="result-analyzed" class="muted"></p>
						</div>
						<button id="new-analysis" class="secondary-button" type="button">Analyze another <span aria-hidden="true">-&gt;</span></button>
					</div>

					<div class="score-banner">
						<div class="score-copy">
							<p class="eyebrow light-eyebrow">Overall score</p>
							<div class="score-number"><span id="overall-score">--</span><small>/100</small></div>
							<p id="score-label" class="score-label"></p>
							<p id="score-summary" class="score-summary"></p>
						</div>
						<div class="score-breakdown">
							<div class="breakdown-row"><span>AI Readiness <b id="ai-score">--</b></span><div class="progress-track"><i id="ai-progress"></i></div></div>
							<div class="breakdown-row"><span>Website Quality <b id="quality-score">--</b></span><div class="progress-track"><i id="quality-progress"></i></div></div>
							<p class="score-method">AI visibility weighted 60% · website quality weighted 40%</p>
						</div>
					</div>

					<div class="report-grid">
						<section class="report-section" aria-labelledby="ai-heading">
							<div class="section-heading"><div><p class="section-kicker">01 / visibility</p><h3 id="ai-heading">AI Readiness</h3></div><span id="ai-label" class="section-score"></span></div>
							<p class="section-intro">The public signals that help modern systems discover and understand your site.</p>
							<div id="ai-items" class="signal-list"></div>
						</section>

						<section class="report-section" aria-labelledby="quality-heading">
							<div class="section-heading"><div><p class="section-kicker">02 / foundations</p><h3 id="quality-heading">Website Quality</h3></div><span id="quality-label" class="section-score"></span></div>
							<p class="section-intro">The on-page fundamentals that make a website clear, useful and easy to parse.</p>
							<div id="quality-items" class="signal-list"></div>
						</section>
					</div>

					<section class="action-section" aria-labelledby="action-heading">
						<div class="section-heading"><div><p class="section-kicker">03 / next moves</p><h3 id="action-heading">Action Plan</h3></div><span class="section-score">prioritized</span></div>
						<p class="section-intro">A short list of deterministic recommendations based on the signals found above.</p>
						<div id="action-items" class="action-list"></div>
					</section>

					<div class="report-footnote"><span>Bounded inspection</span><span id="request-count"></span><span>Nothing stored</span></div>
				</section>
			</main>

			<footer><span>AI Factory</span><span>Experiment 004 · Site Intelligence AI</span></footer>
		</div>

		<script>
			type Status = 'pass' | 'warn' | 'fail';
			type Access = 'allowed' | 'blocked' | 'unrestricted';
			interface ScoreItem { id: string; label: string; status: Status; detail: string; }
			interface AiSection { id: string; label: string; earned: number; max: number; items: ScoreItem[]; }
			interface AiReport {
				url: string; finalUrl: string; checkedAt: string; requests: number;
				homepage: { title: string | null; metaDescription: string | null; canonical: string | null; h1Count: number; jsonLd: { blocks: number; types: string[] }; };
				robots: { found: boolean; crawlers: Array<{ name: string; access: Access }>; };
				llmsTxt: { found: boolean; };
				sitemap: { found: boolean; urlCount: number; };
				score: { total: number; max: number; label: string; sections: AiSection[]; };
			}
			interface QualityItem { id: string; label: string; status: Status; points: number; maxPoints: number; detail: string; }
			interface Report {
				url: string; finalUrl: string; analyzedAt: string; requests: number; overallScore: number;
				aiReadiness: AiReport;
				websiteQuality: { score: number; max: number; items: QualityItem[] };
				actions: Array<{ title: string; detail: string; severity: Status; fix?: string }>;
			}

			const form = document.getElementById('intelligence-form') as HTMLFormElement | null;
			const input = document.getElementById('url') as HTMLInputElement | null;
			const button = document.getElementById('submit-button') as HTMLButtonElement | null;
			const loading = document.getElementById('state-loading');
			const errorBox = document.getElementById('state-error');
			const errorMessage = document.getElementById('error-message');
			const results = document.getElementById('state-results');

			function el<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string): HTMLElementTagNameMap[K] {
				const node = document.createElement(tag);
				if (className) node.className = className;
				if (text !== undefined) node.textContent = text;
				return node;
			}

			function show(active: HTMLElement | null): void {
				for (const node of [loading, errorBox, results]) {
					if (!node) continue;
					if (node === active) node.removeAttribute('hidden');
					else node.setAttribute('hidden', '');
				}
			}

			const STATUS_LABEL: Record<Status, string> = { pass: 'Good', warn: 'Review', fail: 'Missing' };
			const GLYPH: Record<Status, string> = { pass: 'OK', warn: '!', fail: 'NO' };

			function signalRow(label: string, status: Status, detail: string): HTMLElement {
				const row = el('div', 'signal-row');
				const badge = el('span', `status-badge status-${status}`, GLYPH[status]);
				badge.setAttribute('aria-label', STATUS_LABEL[status]);
				const body = el('div', 'signal-body');
				body.append(el('strong', undefined, label), el('span', undefined, detail));
				row.append(badge, body, el('span', `status-label status-${status}`, STATUS_LABEL[status]));
				return row;
			}

			function itemById(report: AiReport, id: string): ScoreItem | undefined {
				return report.score.sections.flatMap((section) => section.items).find((item) => item.id === id);
			}

			function renderAi(report: AiReport): void {
				const box = document.getElementById('ai-items');
				if (!box) return;
				const crawlers = report.robots.crawlers;
				const blocked = crawlers.filter((crawler) => crawler.access === 'blocked');
				const accessItem = itemById(report, 'ai-crawlers-allowed');
				const robotsItem = itemById(report, 'robots-accessible');
				const schemaItem = itemById(report, 'json-ld');
				box.replaceChildren(
					signalRow('robots.txt', robotsItem?.status ?? 'fail', report.robots.found ? 'Found and parsed at the site root.' : 'Not found at the site root.'),
					signalRow('AI crawler access', accessItem?.status ?? 'fail', blocked.length ? `${blocked.length} listed crawler${blocked.length === 1 ? '' : 's'} disallowed.` : 'No listed AI crawler is blocked.'),
					signalRow('llms.txt', report.llmsTxt.found ? 'pass' : 'warn', report.llmsTxt.found ? 'Text file found and readable.' : 'Not found; optional convention.'),
					signalRow('Structured data', schemaItem?.status ?? 'fail', report.homepage.jsonLd.blocks ? `${report.homepage.jsonLd.blocks} JSON-LD block${report.homepage.jsonLd.blocks === 1 ? '' : 's'} found.` : 'No JSON-LD detected.'),
				);
				const score = document.getElementById('ai-score');
				const progress = document.getElementById('ai-progress') as HTMLElement | null;
				const label = document.getElementById('ai-label');
				if (score) score.textContent = `${report.score.total}/${report.score.max}`;
				if (progress) progress.style.width = `${Math.round((report.score.total / report.score.max) * 100)}%`;
				if (label) label.textContent = `${report.score.total} / ${report.score.max}`;
			}

			function renderQuality(report: Report): void {
				const box = document.getElementById('quality-items');
				if (!box) return;
				box.replaceChildren(...report.websiteQuality.items.map((item) => signalRow(item.label, item.status, item.detail)));
				const score = document.getElementById('quality-score');
				const progress = document.getElementById('quality-progress') as HTMLElement | null;
				const label = document.getElementById('quality-label');
				if (score) score.textContent = `${report.websiteQuality.score}/100`;
				if (progress) progress.style.width = `${report.websiteQuality.score}%`;
				if (label) label.textContent = `${report.websiteQuality.score} / 100`;
			}

			function renderActions(report: Report): void {
				const box = document.getElementById('action-items');
				if (!box) return;
				if (!report.actions.length) {
					box.replaceChildren(el('p', 'empty-plan', 'All checked signals look healthy. Keep them current as the site changes.'));
					return;
				}
				box.replaceChildren(...report.actions.map((action, index) => {
					const row = el('div', 'action-row');
					row.append(el('span', `action-index action-${action.severity}`, String(index + 1).padStart(2, '0')));
					const body = el('div', 'action-body');
					body.append(el('strong', undefined, action.title), el('span', undefined, action.detail));
					if (action.fix) body.append(el('em', undefined, action.fix));
					row.append(body);
					return row;
				}));
			}

			function render(report: Report): void {
				const overall = document.getElementById('overall-score');
				const label = document.getElementById('score-label');
				const summary = document.getElementById('score-summary');
				const analyzed = document.getElementById('result-analyzed');
				if (overall) overall.textContent = String(report.overallScore);
				if (label) label.textContent = report.overallScore >= 85 ? 'Strong foundation' : report.overallScore >= 70 ? 'Getting there' : 'Needs attention';
				if (summary) summary.textContent = report.actions.length ? `${report.actions.length} prioritized improvement${report.actions.length === 1 ? '' : 's'} found.` : 'Every signal in this report is in good shape.';
				if (analyzed) {
					analyzed.textContent = `Analyzed ${report.url}${report.finalUrl !== report.url ? ` -> ${report.finalUrl}` : ''} · ${new Date(report.analyzedAt).toLocaleString()}`;
				}
				renderAi(report.aiReadiness);
				renderQuality(report);
				renderActions(report);
				const requests = document.getElementById('request-count');
				if (requests) requests.textContent = `${report.requests} requests made`;
			}

			async function analyze(rawUrl: string): Promise<void> {
				show(loading);
				if (button) button.disabled = true;
				try {
					const response = await fetch('/api/site-intelligence', {
						method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ url: rawUrl }),
					});
					const data = await response.json() as { ok: true; report: Report } | { ok: false; error: string };
					if (!data.ok) {
						if (errorMessage) errorMessage.textContent = data.error;
						show(errorBox);
						return;
					}
					render(data.report);
					show(results);
				} catch {
					if (errorMessage) errorMessage.textContent = 'The analysis could not be completed. Please try again.';
					show(errorBox);
				} finally {
					if (button) button.disabled = false;
				}
			}

			form?.addEventListener('submit', (event) => {
				event.preventDefault();
				const value = input?.value.trim() ?? '';
				if (!value) {
					if (errorMessage) errorMessage.textContent = 'Enter a website URL to analyze.';
					show(errorBox);
					return;
				}
				void analyze(value);
			});

			document.getElementById('new-analysis')?.addEventListener('click', () => {
				show(null);
				input?.focus();
				window.scrollTo({ top: 0, behavior: 'smooth' });
			});
		</script>
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(html) { background: #f1f4f1; }
	:global(body) { margin: 0; color: #18221f; background: #f1f4f1; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
	:global(button), :global(input) { font: inherit; }
	:global(button) { cursor: pointer; }
	.site-shell { min-height: 100vh; overflow: hidden; }
	.topbar, main, footer { width: min(1160px, calc(100% - 48px)); margin: 0 auto; }
	.topbar { height: 78px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #d9e0d9; }
	.brand { display: inline-flex; align-items: center; gap: 10px; color: #18221f; text-decoration: none; font-size: 14px; font-weight: 750; letter-spacing: .01em; }
	.brand-mark { display: grid; place-items: center; width: 30px; height: 30px; color: #f1f4f1; background: #183d35; font: 700 10px/1 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: 0; }
	.experiment-tag, .eyebrow, .section-kicker, .panel-topline, .light-eyebrow { font: 700 10px/1.2 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .14em; text-transform: uppercase; }
	.experiment-tag { color: #678078; }
	.hero { min-height: 510px; display: grid; grid-template-columns: minmax(0, 1fr) 390px; align-items: center; gap: 80px; padding: 72px 0 68px; }
	.hero-copy { max-width: 670px; }
	.eyebrow { color: #27836c; margin: 0 0 20px; }
	h1 { max-width: 680px; margin: 0; color: #183d35; font-size: clamp(42px, 5.2vw, 68px); line-height: 1.02; letter-spacing: -.035em; font-weight: 760; }
	.hero-subtitle { max-width: 570px; margin: 24px 0 34px; color: #5b6c65; font-size: 18px; line-height: 1.55; }
	.input-row { display: flex; max-width: 620px; padding: 5px; background: #fff; border: 1px solid #c9d4cd; box-shadow: 0 10px 25px rgba(28, 57, 46, .08); }
	input { min-width: 0; flex: 1; padding: 14px 16px; color: #18221f; border: 0; outline: 0; background: transparent; font-size: 16px; }
	input::placeholder { color: #9baaa3; }
	input:focus-visible { box-shadow: inset 0 0 0 2px #8ec9b1; }
	#submit-button { min-width: 126px; padding: 13px 18px; color: #f7fbf7; border: 0; background: #183d35; font-weight: 700; transition: background .2s, transform .2s; }
	#submit-button:hover { background: #276452; transform: translateY(-1px); }
	#submit-button:disabled { cursor: wait; opacity: .65; transform: none; }
	.input-note { margin: 12px 0 0 4px; color: #82928a; font-size: 12px; }
	.hero-panel { position: relative; min-height: 370px; padding: 25px; color: #e8f1e9; background: #183d35; box-shadow: 18px 18px 0 #c8d7cd; }
	.panel-topline { display: flex; align-items: center; gap: 8px; color: #a3c6b4; letter-spacing: .11em; }
	.pulse-dot { width: 7px; height: 7px; background: #d4e86a; border-radius: 50%; box-shadow: 0 0 0 5px rgba(212, 232, 106, .12); }
	.signal-map { position: relative; height: 265px; margin-top: 12px; }
	.signal-ring { position: absolute; left: 50%; top: 50%; border: 1px solid #467665; transform: translate(-50%, -50%) rotate(18deg); }
	.signal-ring-one { width: 190px; height: 190px; }
	.signal-ring-two { width: 125px; height: 125px; border-color: #739d89; transform: translate(-50%, -50%) rotate(-26deg); }
	.signal-core { position: absolute; left: 50%; top: 50%; display: grid; place-items: center; width: 75px; height: 75px; color: #183d35; background: #d4e86a; border-radius: 50%; transform: translate(-50%, -50%); font: 800 13px/1.1 ui-monospace, monospace; text-align: center; }
	.signal-label { position: absolute; color: #a3c6b4; font: 600 9px/1.2 ui-monospace, monospace; letter-spacing: .09em; }
	.label-top { top: 25px; left: 50%; transform: translateX(-50%); }
	.label-right { right: -3px; top: 50%; transform: translateY(-50%) rotate(90deg); transform-origin: center; }
	.label-bottom { bottom: 22px; left: 50%; transform: translateX(-50%); }
	.preview-footer { display: flex; align-items: center; gap: 10px; color: #b6d0c1; font-size: 11px; }
	.preview-line { height: 1px; flex: 1; background: #4a7967; }
	.trust-strip { display: flex; justify-content: space-between; gap: 20px; padding: 19px 0; border-top: 1px solid #d3ddd5; border-bottom: 1px solid #d3ddd5; color: #71827a; font: 11px/1.3 ui-monospace, monospace; text-transform: uppercase; letter-spacing: .07em; }
	.trust-strip strong { margin-right: 7px; color: #27836c; font-size: 14px; }
	.state-box { display: flex; align-items: flex-start; gap: 15px; margin: 42px 0; padding: 22px; border: 1px solid #cedad2; background: #fff; }
	.state-box strong { display: block; font-size: 15px; }
	.state-box p { margin: 7px 0 0; color: #6c7e75; font-size: 13px; line-height: 1.5; }
	.loader { width: 18px; height: 18px; flex: none; border: 2px solid #c8ddd2; border-top-color: #27836c; border-radius: 50%; animation: spin .8s linear infinite; }
	.state-icon { display: grid; place-items: center; width: 20px; height: 20px; flex: none; color: #8b4934; border: 1px solid #d8a795; border-radius: 50%; font-weight: 800; }
	.error-box { border-color: #e0c4b8; background: #fff8f5; }
	.results { padding: 76px 0 80px; }
	.results-heading-row { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
	.results h2 { margin: 0; color: #183d35; font-size: 36px; line-height: 1.1; letter-spacing: -.025em; }
	.muted { margin: 10px 0 0; color: #788880; font-size: 13px; overflow-wrap: anywhere; }
	.secondary-button { padding: 10px 0; color: #27836c; border: 0; border-bottom: 1px solid #8ab7a4; background: transparent; font-size: 13px; font-weight: 700; }
	.score-banner { display: grid; grid-template-columns: 1fr 1.1fr; gap: 50px; padding: 34px; color: #e8f1e9; background: #183d35; }
	.light-eyebrow { color: #a3c6b4; }
	.score-number { margin-top: 15px; color: #d4e86a; font-size: 72px; line-height: .9; font-weight: 760; letter-spacing: -.05em; }
	.score-number small { margin-left: 7px; color: #a3c6b4; font-size: 18px; letter-spacing: 0; }
	.score-label { margin: 14px 0 0; color: #fff; font-size: 16px; font-weight: 700; }
	.score-summary { margin: 8px 0 0; color: #a3c6b4; font-size: 13px; }
	.score-breakdown { align-self: end; }
	.breakdown-row { margin-top: 21px; color: #d7e8dc; font-size: 13px; }
	.breakdown-row span { display: flex; justify-content: space-between; gap: 15px; }
	.breakdown-row b { color: #fff; }
	.progress-track { height: 5px; margin-top: 9px; background: #315b4b; }
	.progress-track i { display: block; width: 0; height: 100%; background: #d4e86a; transition: width .5s ease; }
	.score-method { margin: 26px 0 0; color: #719987; font: 10px/1.4 ui-monospace, monospace; }
	.report-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }
	.report-section, .action-section { padding: 27px; border: 1px solid #d4ded6; background: #fff; }
	.section-heading { display: flex; align-items: start; justify-content: space-between; gap: 15px; }
	.section-kicker { margin: 0 0 9px; color: #82948b; font-size: 9px; }
	.report-section h3, .action-section h3 { margin: 0; color: #183d35; font-size: 23px; letter-spacing: -.02em; }
	.section-score { color: #27836c; font: 700 12px ui-monospace, monospace; white-space: nowrap; }
	.section-intro { min-height: 42px; margin: 12px 0 21px; color: #71827a; font-size: 13px; line-height: 1.5; }
	.signal-list { border-top: 1px solid #e2e9e3; }
	.signal-row { display: flex; align-items: center; gap: 11px; min-height: 67px; border-bottom: 1px solid #e2e9e3; }
	.status-badge, .action-index { display: grid; place-items: center; width: 27px; height: 27px; flex: none; font: 800 9px ui-monospace, monospace; }
	.status-badge { border-radius: 50%; }
	.status-pass { color: #1e725a; background: #e1f2e8; }
	.status-warn { color: #96651e; background: #fff0ce; }
	.status-fail { color: #984932; background: #f9e3dc; }
	.signal-body { display: grid; gap: 4px; min-width: 0; flex: 1; }
	.signal-body strong { color: #24352e; font-size: 13px; }
